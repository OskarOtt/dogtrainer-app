{
  "expo": {
    "name": "Flink",
    "slug": "dogtrainer-app",
    "version": "1.2.0",
    "description": "Track training sessions, plans, and progress for your dog.",
    "locales": {
      "en": "./locales/en.json",
      "nb": "./locales/nb.json"
    },
    "orientation": "portrait",
    "icon": "./assets/images/noborder-doglogo.png",
    "scheme": "dogtrainerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/noborder-doglogo.png",
      "bundleIdentifier": "com.oskar.ott.dogtrainerapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.oskar.ott.dogtrainerapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/noborder-doglogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/noborder-doglogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E8760",
          "image": "./assets/images/noborder-doglogo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture or dog photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "nb"
            ],
            "android": [
              "en",
              "nb"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9956aa5b-06a1-4809-9f36-08c0d75263f0"
      }
    },
    "owner": "oskar.ott"
  }
}
